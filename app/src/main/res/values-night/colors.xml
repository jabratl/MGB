    <color name="mg_surface">#141722</color>
    <color name="mg_surface_variant">#202435</color>

    <!-- A lighter violet preserves clear accent contrast on dark surfaces. -->
    <color name="mg_primary">#B6A8FF</color>
    <color name="mg_on_primary">#211B3A</color>

    <color name="mg_text">#F0EFF8</color>
    <color name="mg_text_dim">#B0B2C2</color>
    <color name="mg_outline">#34384A</color>

    <!-- Semantic states intentionally stay distinct from the brand accent. -->
    <color name="mg_error">#FF7B72</color>
    <color name="mg_success">#4CD08A</color>

    <color name="mg_toggle_on">#B6A8FF</color>
    <!-- Dark thumb: white on the light violet track was only 2.1:1 -->
    <color name="mg_toggle_thumb">#211B3A</color>
    <color name="thazir_icon_bg">#1B1630</color>

    <bool name="mg_light_bars">false</bool>
