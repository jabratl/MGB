<?xml version="1.0" encoding="utf-8"?>
<!-- S3: address field inside the bar pill. Visual height 36dp (4dp inset) inside a 44dp touch area.
     Resting = quiet inset capsule; focused = surface + violet ring. Theme tokens only (light + dark). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/mg_surface" />
                <stroke android:width="1.5dp" android:color="@color/mg_primary" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/mg_surface_variant" />
                <corners android:radius="18dp" />
            </shape>
        </inset>
    </item>
</selector>
