<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thazir design tokens: LIGHT. Keep resource names stable across the native UI. -->
    <color name="mg_bg">#F8F8FC</color>
    <color name="mg_surface">#FFFFFF</color>
    <color name="mg_surface_variant">#F0F1F7</color>

    <!-- Violet is the primary brand accent; white text remains high-contrast on it. -->
    <color name="mg_primary">#5947C7</color>
    <color name="mg_on_primary">#FFFFFF</color>

    <color name="mg_text">#191A24</color>
    <color name="mg_text_dim">#626477</color>
    <color name="mg_outline">#D9DCE7</color>

    <!-- Semantic states intentionally stay distinct from the brand accent. -->
    <color name="mg_error">#D93025</color>
    <color name="mg_success">#1E9E5A</color>

    <!-- Selected controls share the primary violet; the thumb stays white. -->
    <color name="mg_toggle_on">#5947C7</color>
    <color name="mg_toggle_thumb">#FFFFFF</color>

    <color name="thazir_icon_bg">#1B1630</color>

    <bool name="mg_light_bars">true</bool>
</resources>
